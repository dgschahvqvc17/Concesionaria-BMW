# Puerto del servidor Express
PORT=3000

# AWS
AWS_REGION=us-east-2

# Cognito (salida de `cdk deploy` en infra/)
USER_POOL_ID=us-east-2_XXXXXXXXX
USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB
USUARIOS_TABLE_NAME=Usuarios
VEHICULOS_TABLE_NAME=Vehiculos

# DynamoDB - repuestos (HU04, salida de `cdk deploy` en infra/)
REPUESTOS_TABLE_NAME=Repuestos
MOVIMIENTOS_TABLE_NAME=MovimientosInventario

# S3 para fotografías de vehículos (salida de `cdk deploy` en infra/)
FOTOS_BUCKET_NAME=nombre-del-bucket-de-fotos

# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173
